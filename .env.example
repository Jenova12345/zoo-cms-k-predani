# Šablona proměnných prostředí pro CMS Amphibiárium (server).
#
# Server čte PROMĚNNÉ PROSTŘEDÍ, ne tenhle soubor — .env se nenačítá sám.
# Na produkci je nastav ve službě Windows serveru (nebo je před spuštěním
# vyexportuj). Tenhle soubor je jen reference; zkopíruj ho na .env a hodnoty
# uprav pro sebe. .env je v .gitignore, .env.example zůstává v gitu.

# Klíč pro podpis session cookie. V PRODUKCI POVINNÝ, aspoň 16 znaků
# (doporučeno 64). Když je nastavený, data/session.key se vůbec nezakládá.
# Vygeneruj: openssl rand -hex 32
SESSION_SECRET=

# Platnost přihlášení v hodinách. Výchozí 12, strop je 12 (vyšší se sráží na 12).
SESSION_TTL_HOURS=12

# Adresa, na které server poslouchá. Výchozí 127.0.0.1 (jen lokálně).
# Pro přístup z LAN pavilonu je potřeba konkrétní IP serveru (např. 10.10.10.10)
# nebo 0.0.0.0.
HOST=127.0.0.1

# Port HTTP serveru.
PORT=3000

# Kořen datové složky (displeje, users.json, session.key). Výchozí <repo>/data.
DATA_ROOT=

# Analytický backend chatbota (kolegův). Výchozí http://127.0.0.1:8000.
ANALYTICS_URL=http://127.0.0.1:8000

# --- Displej u deštného pralesa (GET /api/prales) ---

# Souřadnice, pro které se stahuje venkovní teplota z open-meteo.com.
# Výchozí je ZOO Ostrava. API je veřejné, klíč se nikde nezadává.
POCASI_LAT=49.8265
POCASI_LON=18.3242

# Kolik milisekund se čeká na odpověď open-meteo.com. Výchozí 5000.
# Timeout nezdrží tablety: teplota se stahuje na pozadí, ne při požadavku.
POCASI_TIMEOUT_MS=5000

# --- Videomapping (stránka Videomapping v CMS) ---

# Adresy počítačů firmy od videomappingu, na které se posílají OSC zprávy
# přes UDP (/start a /stop). Bez těchhle proměnných platí hodnoty níž, tedy
# zapojení podle dodané dokumentace. Když firma adresy změní, přepiš je tady
# a restartuj server; aplikace se kvůli tomu nepřekládá.
VIDEOMAPPING_WATERSENSE_HOST=10.10.10.51
VIDEOMAPPING_WATERSENSE_PORT=7000
VIDEOMAPPING_LES_HOST=10.10.10.52
VIDEOMAPPING_LES_PORT=7000

# Kolik milisekund se čeká na dokončení odeslání UDP datagramu. Výchozí 3000.
# Zápis do socketu je okamžitý, timeout je pojistka pro případ, že by v adrese
# bylo jméno stroje a zaseklo se překládání DNS.
OSC_TIMEOUT_MS=3000
