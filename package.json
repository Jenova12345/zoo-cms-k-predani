{
  "name": "amphibiarium-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Vzdálený přístup - CMS pavilonu Amphibiárium, ZOO Ostrava",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "seed": "npm run seed --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "useradd": "npm run useradd --workspace server --",
    "userlist": "npm run userlist --workspace server",
    "import-obsahu": "npm run import-obsahu --workspace server --",
    "prevod-obsahu": "npm run prevod-obsahu --workspace server --",
    "prevod-kb": "npm run prevod-kb --workspace server --",
    "kb-check": "npm run kb-check --workspace server",
    "kb-ukazka": "npm run kb-ukazka --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
